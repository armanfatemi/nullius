{
  "name": "@nullius-inverba/kit",
  "version": "0.5.0",
  "description": "Witness recording for agent runs \u2014 harness hooks emit a journal the agent cannot decline to write, and `nullius witness validate` judges it.",
  "license": "MIT",
  "author": "Arman Fatemi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/armanfatemi/nullius.git",
    "directory": "packages/kit"
  },
  "homepage": "https://github.com/armanfatemi/nullius",
  "bugs": "https://github.com/armanfatemi/nullius/issues",
  "keywords": [
    "agents",
    "llm",
    "claude-code",
    "hooks",
    "provenance",
    "audit",
    "journal",
    "subagents",
    "retro"
  ],
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "bin": {
    "nullius-kit": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./cli": {
      "default": "./dist/cli.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/cli.ts --format esm --dts --clean",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@nullius-inverba/claims": "^0.10.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@vitest/coverage-v8": "^4.1.11",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.11"
  }
}
